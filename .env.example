# Local setup: .venv/bin/python scripts/init_local.py
# Production: configure OAuth 2.1 with your identity provider.
AUTH_MODE=oauth
PUBLIC_BASE_URL=https://images.example.com
AUTH_ISSUER_URL=https://identity.example.com
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_SUBJECTS_FILE=/run/secrets/image-subjects.json
# Generate once: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Persist securely across restarts; never commit it or replace it on each boot.
SUBSCRIPTION_ENCRYPTION_KEY=
DB_PATH=./data/jobs.sqlite3
IMAGE_DIR=./data/images
HOST=127.0.0.1
PORT=8000
# Optional exact callback hostname allowlist, comma-separated. Confirm actual
# callback hosts from your own ChatGPT subscription; do not guess them.
CALLBACK_ALLOWED_HOSTS=
# Local token mode only: AUTH_TOKENS_FILE contains {"random-32+-character-token":"tenant-id"}.
# AUTH_SUBJECTS_FILE contains {"issuer-subject-id":{"tenant":"tenant-id","enabled":true}}.
