PUBLIC_BASE_URL=https://images.example.com
# Shared storage namespace. For existing data, use its previous tenant ID.
APP_WORKSPACE_ID=local-demo
# Generate once with cryptography.fernet.Fernet.generate_key().
# Persist securely across restarts; never commit it or replace it on each boot.
SUBSCRIPTION_ENCRYPTION_KEY=
DB_PATH=./data/jobs.sqlite3
IMAGE_DIR=./data/images
HOST=127.0.0.1
PORT=8000
# Optional exact callback hostname allowlist, comma-separated.
CALLBACK_ALLOWED_HOSTS=
